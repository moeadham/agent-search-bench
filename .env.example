# Agent credentials. Use either NAME or NAME_FILE; never commit real values.
ANTHROPIC_API_KEY=
CODEX_API_KEY=
# OPENAI_API_KEY can instead be selected in credentialEnv for compatible setups.
OPENAI_API_KEY=
CURSOR_API_KEY=
OPENROUTER_API_KEY=

# Rename these in agent-search-bench.config.json to the actual provider variables used
# by the pinned Hermes and OpenClaw models (for example OPENROUTER_API_KEY).
HERMES_PROVIDER_API_KEY=
OPENCLAW_PROVIDER_API_KEY=

# Must belong to the independent OpenAI-compatible judge endpoint.
JUDGE_API_KEY=
