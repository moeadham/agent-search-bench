{
  "outputDir": "/runs",
  "repetitions": 1,
  "concurrency": 1,
  "timeoutMs": 600000,
  "agents": {
    "claude": { "enabled": false, "command": "claude", "model": "disabled", "credentialEnv": ["ANTHROPIC_API_KEY"] },
    "codex": { "enabled": false, "command": "codex", "model": "disabled", "credentialEnv": ["CODEX_API_KEY"] },
    "deepseek": { "enabled": false, "command": "dsh", "model": "disabled", "credentialEnv": ["DEEPSEEK_API_KEY"] },
    "antigravity": {
      "enabled": true,
      "command": "agy",
      "model": "gemini-3.8-flash-medium",
      "provider": "gemini",
      "credentialEnv": ["GEMINI_API_KEY"],
      "searchProvider": "google",
      "searchBackend": "Antigravity Google Search"
    },
    "hermes": { "enabled": false, "command": "hermes", "model": "disabled", "credentialEnv": ["OPENROUTER_API_KEY"] },
    "openclaw": { "enabled": false, "command": "openclaw", "model": "disabled", "credentialEnv": ["OPENROUTER_API_KEY"] },
    "cursor": { "enabled": false, "command": "cursor-agent", "model": "disabled", "credentialEnv": ["CURSOR_API_KEY"] }
  },
  "judge": {
    "baseUrl": "https://openrouter.ai/api/v1",
    "model": "anthropic/claude-sonnet-4.6",
    "apiKeyEnv": "JUDGE_API_KEY",
    "timeoutMs": 120000
  },
  "aliases": {}
}
