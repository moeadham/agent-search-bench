{
  "outputDir": "/runs",
  "repetitions": 1,
  "concurrency": 5,
  "timeoutMs": 600000,
  "agents": {
    "claude": { "enabled": true, "command": "claude", "model": "smoke-model", "credentialEnv": ["SMOKE_AGENT_KEY"] },
    "codex": { "enabled": true, "command": "codex", "model": "smoke-model", "credentialEnv": ["SMOKE_AGENT_KEY"] },
    "hermes": { "enabled": true, "command": "hermes", "model": "smoke-model", "provider": "smoke-provider", "credentialEnv": ["SMOKE_AGENT_KEY"] },
    "openclaw": { "enabled": true, "command": "openclaw", "model": "smoke-provider/smoke-model", "credentialEnv": ["SMOKE_AGENT_KEY"] },
    "cursor": { "enabled": false, "command": "cursor-agent", "model": "disabled", "credentialEnv": ["SMOKE_AGENT_KEY"] }
  },
  "judge": {
    "baseUrl": "https://judge.invalid/v1",
    "model": "smoke-judge-model",
    "apiKeyEnv": "SMOKE_JUDGE_KEY",
    "timeoutMs": 120000
  },
  "aliases": {}
}
